<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.1</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>ai.agent</groupId>
	<artifactId>ai-agent</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>ai-agent</name>
	<description>AI Agent application</description>
	<url/>
	<licenses>
		<license/>
	</licenses>
	<developers>
		<developer/>
	</developers>
	<scm>
		<connection/>
		<developerConnection/>
		<tag/>
		<url/>
	</scm>
	<properties>
		<java.version>21</java.version>
		<spring-ai.version>2.0.1</spring-ai.version>
		<!-- 下面五个都不在 Boot 的依赖管理清单里，必须自己写版本号（钉住哪个版本的理由见 docs 技术基线） -->
		<tika.version>3.3.2</tika.version>
		<lucene.version>10.5.1</lucene.version>
		<flexmark.version>0.64.8</flexmark.version>
		<h2.version>2.3.232</h2.version>
		<!-- 源码里有中文字面量：不钉 UTF-8 就会跟随平台编码（本机是 GBK），中文被就地改成乱码且不报错 -->
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
	</properties>
	<dependencies>
		<!-- Servlet 栈（内嵌 Tomcat）：注册 @RestController 与承载 SSE 流式端点 -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>

		<!-- 模型接入：OpenAI 兼容协议客户端（本项目指向 DeepSeek） -->
		<dependency>
			<groupId>org.springframework.ai</groupId>
			<artifactId>spring-ai-starter-model-openai</artifactId>
		</dependency>

		<!-- Bean Validation（JSR-380）：结构化输出的字段校验与错误回灌，模型侧不保证字段齐、类型对 -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>

		<!-- 持久层映射：SQL 写在 mapper XML 里，参数按名字绑定、结果映射到不可变 record -->
		<dependency>
			<groupId>org.mybatis.spring.boot</groupId>
			<artifactId>mybatis-spring-boot-starter</artifactId>
			<version>4.1.0</version>
			<!-- 它自带 spring-boot-starter-jdbc（@Transactional 与 DataAccessException 翻译由它提供），不要再单独声明那一个 -->
		</dependency>

		<!-- 数据库：内嵌 H2（MODE=MySQL），存 Agent 运行 trace 与断点检查点，默认内存库 -->
		<dependency>
			<groupId>com.h2database</groupId>
			<artifactId>h2</artifactId>
			<version>${h2.version}</version>
			<!-- 作用域 compile 而不是 runtime：代码里要直接用它的 JdbcConnectionPool（作为 DataSource 实现） -->
		</dependency>

		<!-- 数据库：MySQL 驱动。url 指向 MySQL 时由它建连（ai.agent.store.url 见 application.properties）。
		     不写版本号：Boot 4.1.1 的依赖清单管着它（mysql.version=9.7.0）。
		     它同时提供 java.sql.Driver 与 com.mysql.cj.jdbc.MysqlConnectionPoolDataSource（后者不在这里用） -->
		<dependency>
			<groupId>com.mysql</groupId>
			<artifactId>mysql-connector-j</artifactId>
		</dependency>

		<!-- 文档解析：Word / PDF / HTML / CSV 统一读成文本与 XHTML 结构，供结构化分块使用 -->
		<dependency>
			<groupId>org.apache.tika</groupId>
			<artifactId>tika-core</artifactId>
			<version>${tika.version}</version>
			<!-- 必须显式声明：Tika 3.x 的各格式模块把 core 标成 provided，aggregator 不会把它传递进来 -->
		</dependency>

		<!-- 各格式的解析器实现（PDF/Office/HTML/纯文本），由它把 PDFBox、POI 等一起带进来 -->
		<dependency>
			<groupId>org.apache.tika</groupId>
			<artifactId>tika-parsers-standard-package</artifactId>
			<version>${tika.version}</version>
		</dependency>

		<!-- 检索引擎：BM25 词法检索（内存索引），既用于 RAG 召回也用于分块策略的离线评测 -->
		<dependency>
			<groupId>org.apache.lucene</groupId>
			<artifactId>lucene-core</artifactId>
			<version>${lucene.version}</version>
		</dependency>
		<!-- 中文按二元组切词（CJKBigramFilter），于是不需要引 IK/jieba 这类分词器 -->
		<dependency>
			<groupId>org.apache.lucene</groupId>
			<artifactId>lucene-analysis-common</artifactId>
			<version>${lucene.version}</version>
		</dependency>
		<!-- 查询解析：Lucene 9 起从 core 拆出来的独立制品，必须显式声明 -->
		<dependency>
			<groupId>org.apache.lucene</groupId>
			<artifactId>lucene-queryparser</artifactId>
			<version>${lucene.version}</version>
		</dependency>

		<!-- Markdown 解析：Markdown → HTML（含表格等 GFM 扩展），再走与 Tika 同一套结构提取 -->
		<dependency>
			<groupId>com.vladsch.flexmark</groupId>
			<artifactId>flexmark-all</artifactId>
			<version>${flexmark.version}</version>
		</dependency>

		<!-- MCP Server：把本项目的只读工具按 MCP 协议暴露给外部客户端；webmvc 变体跑在已有的 Servlet 栈上，提供 Streamable HTTP 传输 -->
		<dependency>
			<groupId>org.springframework.ai</groupId>
			<artifactId>spring-ai-starter-mcp-server-webmvc</artifactId>
		</dependency>
	</dependencies>
	<dependencyManagement>
		<dependencies>
			<!-- Spring AI 全家桶（含 MCP）的版本由它统一决定，所以上面两个 spring-ai 依赖都不写版本号 -->
			<dependency>
				<groupId>org.springframework.ai</groupId>
				<artifactId>spring-ai-bom</artifactId>
				<version>${spring-ai.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<build>
		<plugins>
			<!-- 打可执行 jar 与 spring-boot:run -->
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>

</project>
