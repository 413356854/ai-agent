<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<!-- 上游 parent：它再 import spring-boot-dependencies、spring-ai-bom 与
	     spring-ai-alibaba-extensions-bom（DashScope starter 的版本由最后一个管）。
	     relativePath 置空：这份 parent 只从仓库取，磁盘上没有同级目录 -->
	<parent>
		<groupId>com.alibaba.cloud.ai</groupId>
		<artifactId>spring-ai-alibaba</artifactId>
		<version>2.0.0.0-RC1</version>
		<relativePath/>
	</parent>
	<groupId>ai.agent</groupId>
	<artifactId>ai-agent</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>ai-agent</name>
	<description>AI Agent application</description>
	<url/>
	<licenses>
		<license/>
	</licenses>
	<developers>
		<developer/>
	</developers>
	<scm>
		<connection/>
		<developerConnection/>
		<tag/>
		<url/>
	</scm>
	<properties>
		<!-- 三处版本覆盖的原因是 parent 定的基线不是本项目要跑的那一套（见 docs 技术基线）：
		     ① java.version：parent 写 17 并据此设 maven.compiler.source/target，
		        不覆盖则编译目标掉到 17，虚拟线程那部分代码过不去；
		     ② spring-boot.version：parent 写 4.1.0，本项目每个模块的版本号都由它决定，
		        覆盖成 4.1.1 才能回到原基线；
		     ③ spring-ai.version：parent 写 2.0.0，这里显式写出来是为了让"跑的是哪一版"
		        在 properties 里一眼可见，不是靠父 pom 猜 -->
		<java.version>21</java.version>
		<spring-boot.version>4.1.1</spring-boot.version>
		<spring-ai.version>2.0.0</spring-ai.version>
		<!-- parent 的 build 里默认绑了四个会失败或会改写文件的插件，逐个关掉：
		     checkstyle 的 configLocation 是相对它自己 reactor 根的 tools/src/checkstyle/checkstyle.xml，
		     本项目没有那个路径；spotless:apply 绑在 process-sources，javaformat 会改写源码；
		     ⚠️ 反而 sorter 没有"只检查不改"的关闭方式，它的 skip 参数就是这里的 maven.sorter.skip：
		     不写它，每次构建都会把这份 pom 重排一遍（缩进换成 4 空格、`<url/>` 展开成 `<url></url>`），
		     那是 150 行以上的无意义改动 -->
		<checkstyle.skip>true</checkstyle.skip>
		<spotless.apply.skip>true</spotless.apply.skip>
		<spring-javaformat.skip>true</spring-javaformat.skip>
		<maven.sorter.skip>true</maven.sorter.skip>
		<!-- 下面五个都不在 Boot 的依赖管理清单里，必须自己写版本号（钉住哪个版本的理由见 docs 技术基线） -->
		<tika.version>3.3.2</tika.version>
		<lucene.version>10.5.1</lucene.version>
		<flexmark.version>0.64.8</flexmark.version>
		<h2.version>2.3.232</h2.version>
		<!-- 源码里有中文字面量：不钉 UTF-8 就会跟随平台编码（本机是 GBK），中文被就地改成乱码且不报错 -->
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
	</properties>
	<dependencies>
		<!-- Servlet 栈（内嵌 Tomcat）：注册 @RestController 与承载 SSE 流式端点 -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>

		<!-- 模型接入：OpenAI 兼容协议客户端（本项目指向 DeepSeek） -->
		<dependency>
			<groupId>org.springframework.ai</groupId>
			<artifactId>spring-ai-starter-model-openai</artifactId>
		</dependency>

		<!-- 模型接入：阿里云百炼（DashScope）的 Chat / Embedding / 图像等模型，由它自动装配 DashScopeChatModel 等 Bean，
		     配置前缀 spring.ai.dashscope.*。
		     不写版本号：parent 的依赖管理里 import 了 spring-ai-alibaba-extensions-bom，这个 artifactId 归它管 -->
		<dependency>
			<groupId>com.alibaba.cloud.ai</groupId>
			<artifactId>spring-ai-alibaba-starter-dashscope</artifactId>
		</dependency>

		<!-- Bean Validation（JSR-380）：结构化输出的字段校验与错误回灌，模型侧不保证字段齐、类型对 -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>

		<!-- 持久层映射：SQL 写在 mapper XML 里，参数按名字绑定、结果映射到不可变 record -->
		<dependency>
			<groupId>org.mybatis.spring.boot</groupId>
			<artifactId>mybatis-spring-boot-starter</artifactId>
			<version>4.1.0</version>
			<!-- 它自带 spring-boot-starter-jdbc（@Transactional 与 DataAccessException 翻译由它提供），不要再单独声明那一个 -->
		</dependency>

		<!-- 数据库：内嵌 H2（MODE=MySQL），存 Agent 运行 trace 与断点检查点，默认内存库 -->
		<dependency>
			<groupId>com.h2database</groupId>
			<artifactId>h2</artifactId>
			<version>${h2.version}</version>
			<!-- 作用域 compile 而不是 runtime：代码里要直接用它的 JdbcConnectionPool（作为 DataSource 实现） -->
		</dependency>

		<!-- 数据库：MySQL 驱动。url 指向 MySQL 时由它建连（ai.agent.store.url 见 application.properties）。
		     不写版本号：Boot 4.1.1 的依赖清单管着它（mysql.version=9.7.0）。
		     它同时提供 java.sql.Driver 与 com.mysql.cj.jdbc.MysqlConnectionPoolDataSource（后者不在这里用） -->
		<dependency>
			<groupId>com.mysql</groupId>
			<artifactId>mysql-connector-j</artifactId>
		</dependency>

		<!-- 文档解析：Word / PDF / HTML / CSV 统一读成文本与 XHTML 结构，供结构化分块使用 -->
		<dependency>
			<groupId>org.apache.tika</groupId>
			<artifactId>tika-core</artifactId>
			<version>${tika.version}</version>
			<!-- 必须显式声明：Tika 3.x 的各格式模块把 core 标成 provided，aggregator 不会把它传递进来 -->
		</dependency>

		<!-- 各格式的解析器实现（PDF/Office/HTML/纯文本），由它把 PDFBox、POI 等一起带进来 -->
		<dependency>
			<groupId>org.apache.tika</groupId>
			<artifactId>tika-parsers-standard-package</artifactId>
			<version>${tika.version}</version>
		</dependency>

		<!-- 检索引擎：BM25 词法检索（内存索引），既用于 RAG 召回也用于分块策略的离线评测 -->
		<dependency>
			<groupId>org.apache.lucene</groupId>
			<artifactId>lucene-core</artifactId>
			<version>${lucene.version}</version>
		</dependency>
		<!-- 中文按二元组切词（CJKBigramFilter），于是不需要引 IK/jieba 这类分词器 -->
		<dependency>
			<groupId>org.apache.lucene</groupId>
			<artifactId>lucene-analysis-common</artifactId>
			<version>${lucene.version}</version>
		</dependency>
		<!-- 查询解析：Lucene 9 起从 core 拆出来的独立制品，必须显式声明 -->
		<dependency>
			<groupId>org.apache.lucene</groupId>
			<artifactId>lucene-queryparser</artifactId>
			<version>${lucene.version}</version>
		</dependency>

		<!-- Markdown 解析：Markdown → HTML（含表格等 GFM 扩展），再走与 Tika 同一套结构提取 -->
		<dependency>
			<groupId>com.vladsch.flexmark</groupId>
			<artifactId>flexmark-all</artifactId>
			<version>${flexmark.version}</version>
		</dependency>

		<!-- MCP Server：把本项目的只读工具按 MCP 协议暴露给外部客户端；webmvc 变体跑在已有的 Servlet 栈上，提供 Streamable HTTP 传输 -->
		<dependency>
			<groupId>org.springframework.ai</groupId>
			<artifactId>spring-ai-starter-mcp-server-webmvc</artifactId>
		</dependency>

		<!-- 向量库：Milvus 的 VectorStore 实现（MilvusVectorStore）与其自动装配，
		     配置前缀 spring.ai.vectorstore.milvus.*。
		     不写版本号：spring-ai-starter-* 都归 parent 里 import 的 spring-ai-bom 管 -->
		<dependency>
			<groupId>org.springframework.ai</groupId>
			<artifactId>spring-ai-starter-vector-store-milvus</artifactId>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<!-- 打可执行 jar 与 spring-boot:run -->
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>

</project>
