<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!--
  agent_task 表的 SQL。

  ⚠️ status 在这里读成**字符串**，解析成枚举在 AgentTaskRow.toDomain() 里 ——
  让 MyBatis 直接映射枚举的话，库里一个认不出的取值会在读整个列表时抛，
  而"取值的宽松解析"是一条业务判断，它的家应该在枚举自己的 parse 里（只有一处）。

  ⚠️ 插入与取键是两条语句、两次调用（LAST_INSERT_ID() 是连接级的），
  理由与三条实测的弯路见 AgentTaskMapper 的类注释。

  ⚠️ 三个"人"的列存的是 agent_user.id，姓名**由这里关联查询出来**（publisher_name /
  assignee_name / current_executor_name）—— 表里没有姓名列，所以读侧必须带这三个 LEFT JOIN，
  少一个那一格就会静默变成空串（界面显示「未指定任务人」，看起来像真的没指派）。
  ⚠️ LEFT 而不是 INNER：账号那一行万一不在（手工清过库），任务行照样读得出来，代价只是姓名那一格为空；
  INNER JOIN 会让那条任务从看板上消失，而"卡片不见了"是这一页最难发现的一种坏法。
-->
<mapper namespace="ai.agent.mapper.AgentTaskMapper">

	<resultMap id="agentTaskRow" type="ai.agent.mapper.MapperRows$AgentTaskRow">
		<constructor>
			<idArg column="id" javaType="java.lang.Long"/>
			<arg column="publisher_id" javaType="java.lang.Long"/>
			<arg column="publisher_name" javaType="java.lang.String"/>
			<arg column="assignee_id" javaType="java.lang.Long"/>
			<arg column="assignee_name" javaType="java.lang.String"/>
			<arg column="description" javaType="java.lang.String"/>
			<arg column="status" javaType="java.lang.String"/>
			<arg column="current_executor_id" javaType="java.lang.Long"/>
			<arg column="current_executor_name" javaType="java.lang.String"/>
			<!-- 计数列用包装类型：构造器映射对基本类型会在实例化时匹配失败（见 MapperRows 的类注释） -->
			<arg column="current_step" javaType="java.lang.Integer"/>
			<arg column="agent_id" javaType="java.lang.String"/>
			<arg column="result" javaType="java.lang.String"/>
			<arg column="cancel_reason" javaType="java.lang.String"/>
			<arg column="incomplete_reason" javaType="java.lang.String"/>
			<!-- 由来（有没有定时规则）。可为 null = 人发布的；构造器映射对基本类型会匹配失败，
			     所以这一列走包装类型（见 MapperRows 的类注释） -->
			<arg column="schedule_id" javaType="java.lang.Long"/>
			<arg column="created_at" javaType="java.time.Instant"
				typeHandler="ai.agent.mapper.handler.InstantTypeHandler"/>
			<arg column="updated_at" javaType="java.time.Instant"
				typeHandler="ai.agent.mapper.handler.InstantTypeHandler"/>
		</constructor>
	</resultMap>

	<!-- 一条任务的全部列（含三个人的姓名）。别名与 resultMap 里的 column 逐字对应 -->
	<sql id="taskColumns">
		t.id, t.publisher_id, publisher_user.name AS publisher_name,
		t.assignee_id, assignee_user.name AS assignee_name,
		t.current_executor_id, executor_user.name AS current_executor_name,
		t.description, t.status, t.current_step, t.agent_id, t.result, t.cancel_reason, t.incomplete_reason,
		t.schedule_id, t.created_at, t.updated_at
	</sql>

	<!-- 三个 LEFT JOIN 是"姓名从哪来"的唯一出处（理由见文件头） -->
	<sql id="taskFrom">
		FROM agent_task t
		LEFT JOIN agent_user publisher_user ON publisher_user.id = t.publisher_id
		LEFT JOIN agent_user assignee_user ON assignee_user.id = t.assignee_id
		LEFT JOIN agent_user executor_user ON executor_user.id = t.current_executor_id
	</sql>

	<!--
	  发布时不写 agent_id（那一列由平台在第一次接手这条任务时用 updateAgentId 写入），
	  也不写 schedule_id（那一列只有"定时规则派活"那一条路会写，见下面那条 updateScheduleId）——
	  于是"这条任务交给哪个 Agent 应用"与"它是不是定时派出来的"各自只有一个来源，发布人给不了它们。
	-->
	<insert id="insert">
		INSERT INTO agent_task (publisher_id, assignee_id, description, status, current_executor_id, current_step)
		VALUES (#{publisherId}, #{assigneeId}, #{description}, #{status}, #{currentExecutorId}, #{currentStep})
	</insert>

	<select id="lastInsertId" resultType="java.lang.Long">
		SELECT LAST_INSERT_ID()
	</select>

	<select id="findById" resultMap="agentTaskRow">
		SELECT <include refid="taskColumns"/>
		<include refid="taskFrom"/>
		WHERE t.id = #{id}
	</select>

	<!--
	  任务执行器取"下一条要处理的任务"：一次一条（执行是串行的），按变更时间从早到晚。
	  ⚠️ LIMIT 1 由数据库做，不是取回来再挑：取全量的写法会让"每次调度扫一遍全表"，
	  而这张表是按人的操作规模长的，不该在每次调度（默认 10 分钟一次、外加每次记录更新）上全扫。
	  索引 idx_agent_task_status (status, updated_at) 覆盖 WHERE + ORDER BY。
	-->
	<select id="findNextPending" resultMap="agentTaskRow">
		SELECT <include refid="taskColumns"/>
		<include refid="taskFrom"/>
		 WHERE t.status IN
		<foreach item="status" collection="statuses" open="(" separator="," close=")">#{status}</foreach>
		<!-- 这一轮已经失败过的不再取：它没被改动过，所以下一个查询还会排在最前面 -->
		<if test="excluded != null and !excluded.isEmpty()">
		   AND t.id NOT IN
			<foreach item="id" collection="excluded" open="(" separator="," close=")">#{id}</foreach>
		</if>
		 ORDER BY t.updated_at, t.id
		 LIMIT 1
	</select>

	<!-- 看板一次取全量。排序的兜底见 AgentTaskMapper#list 的注释（updated_at 是秒精度，同秒用 id 倒序） -->
	<select id="list" resultMap="agentTaskRow">
		SELECT <include refid="taskColumns"/>
		<include refid="taskFrom"/>
		ORDER BY t.updated_at DESC, t.id DESC
	</select>

	<!--
	  "我的任务"：与这个人有关、而且该由他看见的那些。

	  ⚠️ 判断横跨两列、按状态分组（见 AgentTaskMapper#listForUser 的注释）：
	    · 新发布 / 已完成 / 已取消 —— 发布人或任务人都算；
	    · 待确认需求 / 待验收 —— 只有发布人；
	    · 其余状态 —— 只有任务人。
	  三组状态名由调用方给（SQL 里不写状态名：状态链只有一份定义）。
	-->
	<select id="listForUser" resultMap="agentTaskRow">
		SELECT <include refid="taskColumns"/>
		<include refid="taskFrom"/>
		WHERE (
			(t.status IN
			<foreach item="status" collection="terminalStatuses" open="(" separator="," close=")">#{status}</foreach>
			 AND (t.publisher_id = #{userId} OR t.assignee_id = #{userId}))
			OR (t.status IN
			<foreach item="status" collection="publisherStatuses" open="(" separator="," close=")">#{status}</foreach>
			 AND t.publisher_id = #{userId})
			OR (t.status IN
			<foreach item="status" collection="assigneeStatuses" open="(" separator="," close=")">#{status}</foreach>
			 AND t.assignee_id = #{userId})
		)
		ORDER BY t.updated_at DESC, t.id DESC
	</select>

	<update id="updateProgress">
		UPDATE agent_task
		   SET status = #{status}, current_executor_id = #{currentExecutorId}, current_step = #{currentStep}
		 WHERE id = #{id}
	</update>

	<update id="updateResult">
		UPDATE agent_task SET result = #{result} WHERE id = #{id}
	</update>

	<!-- 「权限不足」那一格里用户改过的描述：与回「新发布」那一步同一次写入（见 DefaultAgentTaskService#revise） -->
	<update id="updateDescription">
		UPDATE agent_task SET description = #{description} WHERE id = #{id}
	</update>

	<update id="updateAgentId">
		UPDATE agent_task SET agent_id = #{agentId} WHERE id = #{id}
	</update>

	<!--
	  盖上"这条任务由哪条定时规则派出来"（见 AgentTaskMapper#updateScheduleId）。
	  单独一条 SQL，不并进 insert：insert 的每一个调用点都是"人在界面上发布"，
	  那一列在那些路径上恒为 NULL —— 并进去就等于每个调用点都要传一个 null。
	-->
	<update id="updateScheduleId">
		UPDATE agent_task SET schedule_id = #{scheduleId} WHERE id = #{id}
	</update>

	<!-- resultMap 里的计数列用包装类型：构造器映射对基本类型会在实例化时匹配失败（见 MapperRows 的类注释） -->
	<resultMap id="scheduleRunRow" type="ai.agent.mapper.MapperRows$ScheduleRunRow">
		<constructor>
			<idArg column="schedule_id" javaType="java.lang.Long"/>
			<arg column="runs" javaType="java.lang.Long"/>
			<arg column="last_at" javaType="java.time.Instant"
				typeHandler="ai.agent.mapper.handler.InstantTypeHandler"/>
		</constructor>
	</resultMap>

	<!--
	  若干条规则各自派过几条任务、最后一次是什么时候。
	  一次查一批（GROUP BY schedule_id），不是每条规则查一次 —— 那是典型的 N+1。
	  ⚠️ schedule_id 为 NULL 的行（人发布的任务）不在此列：`IN (…)` 天然把它们排除在外。
	-->
	<select id="scheduleRunCounts" resultMap="scheduleRunRow">
		SELECT schedule_id, COUNT(*) AS runs, MAX(created_at) AS last_at
		  FROM agent_task
		 WHERE schedule_id IN
		<foreach item="id" collection="scheduleIds" open="(" separator="," close=")">#{id}</foreach>
		 GROUP BY schedule_id
	</select>

	<update id="updateCancel">
		UPDATE agent_task SET cancel_reason = #{cancelReason} WHERE id = #{id}
	</update>

	<!-- 未完成原因：与 updateCancel 分开一条（两列、两种状态，见 AgentTaskMapper#updateIncompleteReason） -->
	<update id="updateIncompleteReason">
		UPDATE agent_task SET incomplete_reason = #{incompleteReason} WHERE id = #{id}
	</update>

</mapper>
