<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!--
  agent_skill 表的 SQL。

  ⚠️ 两个姓名（owner_name / last_modified_name）是 LEFT JOIN agent_user 查出来的，表里没有它们。
  一律 LEFT JOIN 而不是 INNER JOIN：账号那一行万一不在（手工清过库），
  这一条技能照样读得出来、姓名那一格落空（界面显示「未知用户 #id」），
  比"整张列表打不开"好得多（与 AgentTaskMapper.xml 同一条规矩）。

  ⚠️ 两个 LEFT JOIN 各要一个别名：同一个表 JOIN 两次时，
  `LEFT JOIN agent_user u ON …` 写两遍会让第二列的列名与第一条撞上（两边都叫 name）。

  ⚠️ created_at / updated_at 不写进 insert：由 DDL 的 DEFAULT CURRENT_TIMESTAMP 填；
  updated_at 也不写进 update：由 ON UPDATE CURRENT_TIMESTAMP 填（理由见 AgentSkillMapper#update）。
-->
<mapper namespace="ai.agent.mapper.AgentSkillMapper">

	<resultMap id="agentSkillRow" type="ai.agent.mapper.MapperRows$AgentSkillRow">
		<constructor>
			<idArg column="id" javaType="java.lang.Long"/>
			<arg column="folder" javaType="java.lang.String"/>
			<arg column="name" javaType="java.lang.String"/>
			<arg column="description" javaType="java.lang.String"/>
			<arg column="content" javaType="java.lang.String"/>
			<arg column="owner_id" javaType="java.lang.Long"/>
			<arg column="owner_name" javaType="java.lang.String"/>
			<arg column="last_modified_by" javaType="java.lang.Long"/>
			<arg column="last_modified_name" javaType="java.lang.String"/>
			<arg column="created_at" javaType="java.time.Instant"
				typeHandler="ai.agent.mapper.handler.InstantTypeHandler"/>
			<arg column="updated_at" javaType="java.time.Instant"
				typeHandler="ai.agent.mapper.handler.InstantTypeHandler"/>
		</constructor>
	</resultMap>

	<sql id="skillColumns">
		s.id, s.folder, s.name, s.description, s.content, s.owner_id,
		COALESCE(NULLIF(TRIM(owner.display_name), ''), owner.name) AS owner_name,
		s.last_modified_by,
		COALESCE(NULLIF(TRIM(editor.display_name), ''), editor.name) AS last_modified_name,
		s.created_at, s.updated_at
	</sql>

	<!--
	    姓名两列的取法只有一处：显示名优先，没填（NULL 或空串）退回登录名 ——
	    与界面上的 mockLoginLabel / AgentTaskMapper 那三列同一套判据。
	    ⚠️ 两个 JOIN 的账号行都不在时整个表达式是 NULL（不是空串）：那种空与
	    "显示名没填"是两件事，界面按 AgentSkill#displayOwner 分成「未知用户 #id」与姓名两种显示。
	-->
	<sql id="skillFrom">
		FROM agent_skill s
		LEFT JOIN agent_user owner ON owner.id = s.owner_id
		LEFT JOIN agent_user editor ON editor.id = s.last_modified_by
	</sql>

	<select id="list" resultMap="agentSkillRow">
		SELECT <include refid="skillColumns"/>
		<include refid="skillFrom"/>
		ORDER BY s.updated_at DESC, s.id DESC
	</select>

	<select id="byOwner" resultMap="agentSkillRow">
		SELECT <include refid="skillColumns"/>
		<include refid="skillFrom"/>
		 WHERE s.owner_id = #{ownerId}
		ORDER BY s.updated_at DESC, s.id DESC
	</select>

	<select id="findById" resultMap="agentSkillRow">
		SELECT <include refid="skillColumns"/>
		<include refid="skillFrom"/>
		 WHERE s.id = #{id}
	</select>

	<insert id="insert">
		INSERT INTO agent_skill (folder, name, description, content, owner_id, last_modified_by)
		VALUES (#{folder}, #{name}, #{description}, #{content}, #{ownerId}, #{lastModifiedBy})
	</insert>

	<!-- 取键必须紧接着插入调用，理由见 AgentSkillMapper 的类注释 -->
	<select id="lastInsertId" resultType="java.lang.Long">
		SELECT LAST_INSERT_ID()
	</select>

	<update id="update">
		UPDATE agent_skill
		   SET folder = #{folder}, name = #{name}, description = #{description}, content = #{content},
		       last_modified_by = #{lastModifiedBy}
		 WHERE id = #{id}
	</update>

	<!--
	  只改正文，而且要求库里那一份还是 expectedContent（条件更新的理由见 AgentSkillMapper#replaceContent）。
	  description / folder / name 一概不碰：这一条只服务"大模型自补充规则"那一件事，
	  它每碰一列就多一种顺手动坏用户内容的可能。

	  【判据为什么是 COALESCE(content, ?) = ? 而不是某个"NULL 安全等于"运算符】
	  实测这一对库**互不认对方的 NULL 安全等于**：
	    · MySQL 的 `<=>`      → H2 2.3.232（MODE=MySQL）直接报 42001 Syntax error
	    · `IS NOT DISTINCT FROM` → MySQL 8.0.17 报 42000 Syntax error（near 'DISTINCT FROM'）
	  两次都表现为"验收成功、技能静默没变"（MyBatis 打出 Preparing: 之后就断在那里，
	  看不到参数也看不到原因）。所以判据改成：**把库里的 NULL 用一个 Java 侧传来的哨兵替换掉再比**。
	  ⚠️ 哨兵必须走参数（`COALESCE(content, #{sentinel}) = #{expectedContent}`），
	  不能写成 `COALESCE(content, ?) = COALESCE(?, ?)` —— 实测 H2 在那种写法上报
	  HY004「Unknown data type: "?"」（它推不出参数类型），MySQL 反而不报。
	  ⚠️ 也**不要**改成 `COALESCE(content, CHAR(1))`：那会再引入一个 H2 的 `CHAR(n)` 是否可用的前置假设。

	  取舍：调用方传 null 表示"库里那一份不是 NULL 就别匹配"（NULL 永远不等于任何东西）——
	  调用方读到的 expectedContent 是 null 时本来就只有"库里也是 NULL"那一种情形该被放行，
	  而那种情形由哨兵这一侧表达（见 SkillStore#NULL_CONTENT_SENTINEL）。
	-->
	<update id="replaceContent">
		UPDATE agent_skill
		   SET content = #{content}, last_modified_by = #{lastModifiedBy}
		 WHERE id = #{id} AND COALESCE(content, #{sentinel}) = #{expectedContent}
	</update>

	<delete id="delete">
		DELETE FROM agent_skill WHERE id = #{id}
	</delete>

</mapper>
